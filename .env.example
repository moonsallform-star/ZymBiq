# =============================================================================
# ZYMBIQ — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local to version control.
# All production values are set in Vercel project settings.
#
# Variables prefixed with NEXT_PUBLIC_ are safe for the client bundle.
# All other variables are server-only and must never be exposed to the client.
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================
# Neon PostgreSQL connection string with pgbouncer pooling mode.
# Used by Prisma Client at runtime (queries).
# Format: postgresql://user:pass@host/dbname?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"

# Neon direct connection string — no pgbouncer.
# Used by Prisma Migrate (migrations require a direct connection, not pooled).
# Format: postgresql://user:pass@host/dbname?sslmode=require
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"


# =============================================================================
# AUTHENTICATION — NextAuth.js v5
# =============================================================================
# Random secret used to sign and encrypt JWT tokens.
# Generate with: openssl rand -base64 32
# Required in all environments.
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Full canonical URL of the application.
# Development: http://localhost:3000
# Production:  https://yourdomain.com
# Must NOT have a trailing slash.
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — optional.
# If omitted, the Google login button does not appear.
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# =============================================================================
# CLOUDINARY — File Storage and CDN
# =============================================================================
# Your Cloudinary cloud name (visible in Cloudinary dashboard).
CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Cloudinary API key — server-only. Never prefix with NEXT_PUBLIC_.
CLOUDINARY_API_KEY="your-cloudinary-api-key"

# Cloudinary API secret — server-only. Never prefix with NEXT_PUBLIC_.
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"


# =============================================================================
# STRIPE — International Payments (USD)
# =============================================================================
# Stripe secret key — server-only. Never prefix with NEXT_PUBLIC_.
# Use sk_test_* for development, sk_live_* for production.
# Leave as placeholder if not using Stripe — toggle off in admin settings.
STRIPE_SECRET_KEY="sk_test_placeholder"

# Stripe webhook endpoint secret.
# Generated when you register your webhook endpoint in the Stripe dashboard.
# Endpoint to register: https://yourdomain.com/api/payments/stripe/webhook
# Events to enable: payment_intent.succeeded, payment_intent.payment_failed
# Leave as placeholder if not using Stripe.
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Stripe publishable key — safe for the client bundle.
# Use pk_test_* for development, pk_live_* for production.
# Leave as placeholder if not using Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"


# =============================================================================
# GROQ — AI (Search, Order Assistant, Chatbot, Recommender)
# =============================================================================
# Groq API key — server-only. Never prefix with NEXT_PUBLIC_.
# All AI features (search, order assistant, chatbot, price estimator) require this.
# Obtain at: https://console.groq.com
GROQ_API_KEY="gsk_your-groq-api-key"


# =============================================================================
# RESEND — Transactional Email
# =============================================================================
# Resend API key — server-only. Never prefix with NEXT_PUBLIC_.
# Obtain at: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"

# From address for all outgoing emails.
# Use onboarding@resend.dev for local testing (no domain verification needed).
# For production: verify your domain at resend.com and use your own address.
RESEND_FROM_EMAIL="onboarding@resend.dev"


# =============================================================================
# SUPABASE — Realtime Subscriptions (order status, messaging, kanban sync)
# =============================================================================
# Note: Supabase is used ONLY for Realtime (Postgres CDC).
# The primary database is Neon PostgreSQL accessed via Prisma.

# Supabase project URL — safe for the client bundle.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon key — safe for the client bundle (protected by RLS policies).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase service role key — server-only. Bypasses RLS.
# Never prefix with NEXT_PUBLIC_. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"


# =============================================================================
# SEED SCRIPT — scripts/seed.ts
# =============================================================================
# Used only by `pnpm db:seed` to create the initial admin account.
# These variables are not read by the application at runtime.
# After seeding, you may remove these from your environment if preferred.
# Minimum recommended password length: 12 characters.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your-secure-admin-password-min-12-chars"


# =============================================================================
# DEVFORGE — Build Automation API
# =============================================================================
# DevForge API key and URL are stored in the database (SiteConfig table)
# and managed through the admin settings panel at /admin/settings.
# They are NOT stored as environment variables — no entry required here.
# This allows the admin to update them without redeployment.
# =============================================================================